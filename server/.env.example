# ---------- Server ----------
PORT=4000
NODE_ENV=development            # set to "production" when deploying (it refuses demo auth and the in-memory store)
CORS_ORIGIN=http://localhost:5173   # comma-separated list of allowed browser origins

# ---------- Auth (Clerk) ----------
# Clerk dashboard -> API Keys. The server derives the token issuer from the publishable key and verifies session JWTs
# against Clerk's public JWKS. (Alternatively set CLERK_ISSUER, or CLERK_JWT_KEY with the PEM public key for offline verification.)
CLERK_PUBLISHABLE_KEY=
# CLERK_AUTHORIZED_PARTIES=http://localhost:5173   # optional: only accept tokens issued for these frontend origins
# Leave everything above empty to use DEMO auth (insecure, development only).

# ---------- AI (OpenAI) ----------
OPENAI_API_KEY=                 # empty -> offline demo engine (rule-based, no AI)
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------- Storage (Supabase) ----------
# Run supabase/migrations/001_init.sql in the Supabase SQL editor first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # server-side only! Never put this in the client or commit it.
# Empty -> in-memory store (data lost on restart)

# ---------- Limits ----------
DAILY_LIMIT=25                  # AI analyses per user per rolling 24h (protects your OpenAI bill)
RATE_PER_MINUTE=12
