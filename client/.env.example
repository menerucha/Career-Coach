# Clerk publishable key (safe to expose). Leave empty to use the DEMO sign-in (development only).
VITE_CLERK_PUBLISHABLE_KEY=
# API base path. Default "/api" works with the Vite dev proxy and the nginx config.
# VITE_API_BASE=/api
# Where the dev server proxies /api to:
# VITE_API_PROXY=http://localhost:4000
